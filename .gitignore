# =============================================================================
#  KUTSU Sense — .gitignore
#  Keeps editor state, caches, backups, build output and personal/local
#  settings out of the public repository. Design sources, fabrication outputs,
#  renders and firmware source are all tracked.
# =============================================================================


# -----------------------------------------------------------------------------
# KiCad
# -----------------------------------------------------------------------------
# Local history: nested git repos KiCad keeps per project (~49 MB in KUTSU 1.0)
.history/

# Per-user project state (open sheets, layer visibility, zoom). Includes the
# stray temp copies such as kut2575.kicad_prl / kutC63D.kicad_prl
*.kicad_prl

# Footprint-library cache, rebuilt automatically
fp-info-cache

# Backups, autosaves and lock files
*-backups/
_autosave-*
*.kicad_sch-bak
*.kicad_pcb-bak
*.sch-bak
*.bak
*.lck
~*.lck
\#auto_saved_files\#

# Plot/export scratch output (fabrication sets live in named Gerber folders)
gerber_temp/


# -----------------------------------------------------------------------------
# Blender
# -----------------------------------------------------------------------------
# Automatic previous-save backups (.blend1, .blend2, …), each as large as the
# .blend itself (8–16 MB)
*.blend[0-9]
*.blend[0-9][0-9]


# -----------------------------------------------------------------------------
# Eclipse / Espressif IDE / ESP-IDF
# -----------------------------------------------------------------------------
# Eclipse workspace metadata. Contains an embedded browser profile (cache,
# cookies, local storage, sessions), logs and lock files. Never publish.
.metadata/

# Eclipse project descriptors, regenerated when the project is imported
.project
.cproject
.settings/
.launches/

# ESP-IDF build output and generated config
build/
sdkconfig.old
managed_components/
dependencies.lock


# -----------------------------------------------------------------------------
# Arduino / PlatformIO
# -----------------------------------------------------------------------------
*.bin
*.elf
*.map
*.hex
.pio/
.pioenvs/
.piolibdeps/


# -----------------------------------------------------------------------------
# Python / CircuitPython
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/


# -----------------------------------------------------------------------------
# AI assistant / editor local settings (contain local paths and usernames)
# -----------------------------------------------------------------------------
.claude/
.vscode/
.idea/
*.code-workspace
*.swp
*~


# -----------------------------------------------------------------------------
# Operating-system junk
# -----------------------------------------------------------------------------
desktop.ini
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
._*
